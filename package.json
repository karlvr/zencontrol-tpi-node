		"eslint": "^10.1.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"is-in-subnet": "^4.0.1"
